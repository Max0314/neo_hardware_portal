FROM node:20-bookworm-slim AS build
WORKDIR /app

# 国内构建建议在 compose / .env 设置 NPM_REGISTRY=https://registry.npmmirror.com
ARG NPM_REGISTRY=
ENV NPM_CONFIG_FETCH_TIMEOUT=600000 \
    NPM_CONFIG_FETCH_RETRIES=5

COPY package.json package-lock.json ./
# 不使用 BuildKit --mount，避免未启用 BuildKit 的环境构建失败
RUN sh -ec 'if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi; npm ci --no-audit --no-fund'

COPY . .
# 与历史镜像一致：仅 vite 打包（全量 tsc 在仓库内另有未清理告警）
RUN npx vite build \
    && test -f dist/bom_tool/coord-bom-package.html \
    || cp BOM_TOOL/坐标文件bom封装对比.html dist/bom_tool/coord-bom-package.html

FROM nginx:alpine
COPY nginx.docker.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
