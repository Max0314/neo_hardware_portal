# 本地开发可在此填写密钥。Docker 统一部署时请以仓库根目录的 .env 为准
#（根目录 compose 的 env_file 注入后端；本目录 .env 被 .dockerignore 排除，不会进入镜像）。
# cp .env.example .env

DEEPSEEK_API_KEY=
# 可选：DeepSeek OpenAI 兼容 Base URL（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=
ARK_API_KEY=
TOKENPLAN_API_KEY=
TOKENPLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 可选：其它已在项目中支持的密钥（见仓库内配置说明）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
