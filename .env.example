DINGTALK_CLIENT_SECRET=

# ---------- YiDa (Yida) form sync ----------
# YiDa systemToken (App -> Dev -> App Secret). Required for material data sync.
YIDA_SYSTEM_TOKEN=
# Default access password for material libraries created/updated by YiDa sync.
# Required by the sync button / daily scheduler (CLI runs can export it ad-hoc).
YIDA_LIBRARY_PASSWORD=
# Optional overrides (defaults baked into config):
# YIDA_APP_TYPE=APP_MRBK7RVLFEMKQ1B36GIF
# Required. YiDa returns form instances according to THIS account's data permission,
# so it decides what the sync can read. The account must have data permission on every
# material form; prefer a dedicated service account over a person's own userId, because
# a transfer or departure silently reduces the sync to "0 instances" on every form.
YIDA_QUERY_USER_ID=
# Special multi-material forms whose replacement group label is built from
# Value|Voltage Rating|Wattage/Amp|Tolerance|Temp Tolerance|Life Time|Material|Package.
# Simple form (diagnostic only; production sync needs a stable library_name):
# YIDA_SPECIAL_MATERIAL_FORMS=FORM-AAA,FORM-BBB
# JSON form (use this in production):
# YIDA_SPECIAL_MATERIAL_FORMS=[{"form_uuid":"FORM-AAA","library_name":"容阻感优选表"}]
YIDA_SPECIAL_MATERIAL_FORMS=
# Production writes use an explicit JSON allowlist. Each item must carry both the
# YiDa form UUID and the target material-library name. Example:
# YIDA_MATERIAL_FORMS=[{"form_uuid":"FORM-AAA","source_name":"0402电容(C)","library_name":"0402电容(C)"}]
YIDA_MATERIAL_FORMS=[]
# Keep automatic discovery off in production. It is only for read-only diagnosis.
YIDA_AUTO_DISCOVER_MATERIAL_FORMS=0
# The daily sync remains disabled until the allowlist and source data are verified.
YIDA_SYNC_SCHEDULER_ENABLED=0
# Block a sync when a library with >= 20 rows would fall below 50% of its current size.
YIDA_MIN_ROW_RETAIN_RATIO=0.5
YIDA_ROW_REDUCTION_MIN_BASELINE=20
# ???????????? dept_id?????????????????????????
